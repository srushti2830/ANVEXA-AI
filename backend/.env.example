ANVEXA_APP_NAME=ANVEXA AI API
ANVEXA_APP_VERSION=0.1.0
ANVEXA_ENVIRONMENT=development
ANVEXA_API_V1_PREFIX=/api/v1
ANVEXA_LOG_LEVEL=INFO
ANVEXA_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/anvexa_db
ANVEXA_DATABASE_POOL_SIZE=5
ANVEXA_DATABASE_MAX_OVERFLOW=10
ANVEXA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ANVEXA_EMBEDDING_DIMENSION=384

# Authentication & Security
ANVEXA_JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_MIN_32_CHARACTERS_LONG
ANVEXA_JWT_ALGORITHM=HS256
ANVEXA_ACCESS_TOKEN_EXPIRE_MINUTES=30
ANVEXA_REFRESH_TOKEN_EXPIRE_DAYS=7
ANVEXA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ANVEXA_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
ANVEXA_AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300
